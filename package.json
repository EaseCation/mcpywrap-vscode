{
  "name": "mcpywrap-vscode",
  "displayName": "mcpywrap — 游戏测试工作区",
  "description": "在 VS Code 中通过 mcpy CLI 管理 Minecraft 中国版测试会话、执行 Python 与热更模块。",
  "version": "0.1.4",
  "publisher": "easecation",
  "repository": {
    "type": "git",
    "url": "https://github.com/EaseCation/mcpywrap-vscode.git"
  },
  "homepage": "https://github.com/EaseCation/mcpywrap-vscode#readme",
  "bugs": {
    "url": "https://github.com/EaseCation/mcpywrap-vscode/issues"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/pyproject.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "mcpy 可以执行项目脚本；仅在受信任的工作区启用。"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mcpy.refresh",
        "title": "mcpy: 刷新测试工作区",
        "icon": "$(refresh)"
      },
      {
        "command": "mcpy.run",
        "title": "mcpy: 运行测试",
        "icon": "$(play)"
      },
      {
        "command": "mcpy.newWorld",
        "title": "mcpy: 新建测试世界"
      },
      {
        "command": "mcpy.runTwoClients",
        "title": "mcpy: 运行双客户端测试"
      },
      {
        "command": "mcpy.stop",
        "title": "mcpy: 停止所选会话或联调组",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mcpy.logs",
        "title": "mcpy: 查看日志快照",
        "icon": "$(output)"
      },
      {
        "command": "mcpy.selectTarget",
        "title": "mcpy: 选择执行目标"
      },
      {
        "command": "mcpy.executeSelection",
        "title": "mcpy: 在游戏中执行 Python 选区"
      },
      {
        "command": "mcpy.reloadFile",
        "title": "mcpy: 热更当前 Python 模块",
        "icon": "$(sync)"
      },
      {
        "command": "mcpy.doctor",
        "title": "mcpy: 检查运行环境"
      },
      {
        "command": "mcpy.configure",
        "title": "mcpy: 配置 CLI 路径"
      },
      {
        "command": "mcpy.console",
        "title": "mcpy: 连接会话日志",
        "icon": "$(terminal)"
      },
      {
        "command": "mcpy.showEngineLog",
        "title": "mcpy: 显示引擎日志",
        "icon": "$(output)"
      },
      {
        "command": "mcpy.showScriptLog",
        "title": "mcpy: 显示脚本系统日志",
        "icon": "$(output)"
      },
      {
        "command": "mcpy.switchLog",
        "title": "mcpy: 切换引擎 / 脚本系统",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "mcpy.toggleLogDetails",
        "title": "mcpy: 切换协议详情",
        "icon": "$(list-selection)"
      },
      {
        "command": "mcpy.disconnectLogs",
        "title": "mcpy: 断开日志订阅",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mcpy.newSnippet",
        "title": "mcpy: 新建运行时 Python 片段",
        "icon": "$(file-code)"
      },
      {
        "command": "mcpy.runSnippet",
        "title": "mcpy: 在游戏执行（无需保存）",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && !mcpy.pythonBusy"
      },
      {
        "command": "mcpy.changeSnippetTarget",
        "title": "mcpy: 切换片段执行目标",
        "icon": "$(server-process)"
      },
      {
        "command": "mcpy.developmentEnvironment",
        "title": "mcpy: Python 开发环境与补全",
        "icon": "$(package)"
      }
    ],
    "configuration": {
      "title": "mcpywrap",
      "properties": {
        "mcpy.executable": {
          "type": "string",
          "default": "mcpy",
          "scope": "machine-overridable",
          "description": "mcpy 可执行文件的名称或绝对路径。填写可执行文件路径，不填写 shell 命令。"
        },
        "mcpy.queryTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "scope": "resource",
          "description": "只读 CLI 查询超时。"
        },
        "mcpy.operationTimeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 10,
          "maximum": 3600,
          "scope": "resource",
          "description": "启动、停止、执行和热更的等待上限；超时后需要查询结果。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpy",
          "title": "游戏测试",
          "icon": "media/game.svg"
        }
      ]
    },
    "views": {
      "mcpy": [
        {
          "id": "mcpy.sessions",
          "name": "测试工作区"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mcpy.sessions",
        "contents": "自动识别工作区内 pyproject.toml 的 [tool.mcpywrap] 声明。打开项目内任意文件，即可使用编辑器右上角的运行入口。\n[配置 CLI](command:mcpy.configure)\n[刷新](command:mcpy.refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mcpy.run",
          "when": "view == mcpy.sessions",
          "group": "navigation@1"
        },
        {
          "command": "mcpy.refresh",
          "when": "view == mcpy.sessions",
          "group": "navigation@2"
        },
        {
          "command": "mcpy.switchLog",
          "when": "view == workbench.panel.output && mcpy.hasRuntime",
          "group": "navigation@10"
        },
        {
          "command": "mcpy.newSnippet",
          "when": "view == workbench.panel.output && mcpy.hasRuntime",
          "group": "navigation@11"
        },
        {
          "command": "mcpy.toggleLogDetails",
          "when": "view == workbench.panel.output && mcpy.hasRuntime",
          "group": "navigation@12"
        },
        {
          "command": "mcpy.disconnectLogs",
          "when": "view == workbench.panel.output && mcpy.hasRuntime",
          "group": "navigation@13"
        }
      ],
      "view/item/context": [
        {
          "command": "mcpy.run",
          "when": "view == mcpy.sessions && viewItem =~ /^mcpy\\.(project|world)$/",
          "group": "inline@1"
        },
        {
          "command": "mcpy.logs",
          "when": "view == mcpy.sessions && viewItem =~ /^mcpy\\.(session|group)$/",
          "group": "inline@1"
        },
        {
          "command": "mcpy.stop",
          "when": "view == mcpy.sessions && viewItem =~ /^mcpy\\.(session|group)$/",
          "group": "inline@2"
        },
        {
          "command": "mcpy.console",
          "when": "view == mcpy.sessions && viewItem =~ /^mcpy\\.(session|group)$/",
          "group": "inline@0"
        },
        {
          "command": "mcpy.developmentEnvironment",
          "when": "view == mcpy.sessions && viewItem == mcpy.project",
          "group": "3_tools@1"
        }
      ],
      "editor/context": [
        {
          "command": "mcpy.executeSelection",
          "when": "editorLangId == python && editorHasSelection && isWorkspaceTrusted && mcpy.activeProject",
          "group": "mcpy@1"
        },
        {
          "command": "mcpy.reloadFile",
          "when": "editorLangId == python && resourceScheme == file && isWorkspaceTrusted && mcpy.activeProject",
          "group": "mcpy@2"
        },
        {
          "command": "mcpy.runSnippet",
          "when": "editorLangId == mcpy-runtime-python && isWorkspaceTrusted",
          "group": "mcpy@1"
        }
      ],
      "editor/title": [
        {
          "command": "mcpy.run",
          "when": "resourcePath in mcpy.projectFiles && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@10"
        },
        {
          "command": "mcpy.reloadFile",
          "when": "resourcePath in mcpy.projectFiles && resourceScheme == file && resourceLangId == python && isWorkspaceTrusted",
          "group": "navigation@11"
        },
        {
          "submenu": "mcpy.projectActions",
          "when": "resourcePath in mcpy.projectFiles && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@12"
        },
        {
          "command": "mcpy.runSnippet",
          "when": "resourceLangId == mcpy-runtime-python && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@0"
        }
      ],
      "mcpy.projectActions": [
        {
          "command": "mcpy.newWorld",
          "group": "1_run@1"
        },
        {
          "command": "mcpy.runTwoClients",
          "group": "1_run@2"
        },
        {
          "command": "mcpy.newSnippet",
          "group": "2_session@1"
        },
        {
          "command": "mcpy.showEngineLog",
          "group": "2_session@2"
        },
        {
          "command": "mcpy.showScriptLog",
          "group": "2_session@3"
        },
        {
          "command": "mcpy.toggleLogDetails",
          "group": "2_session@4"
        },
        {
          "command": "mcpy.console",
          "group": "2_session@0"
        },
        {
          "command": "mcpy.logs",
          "group": "2_session@1"
        },
        {
          "command": "mcpy.stop",
          "group": "2_session@2"
        },
        {
          "command": "mcpy.doctor",
          "group": "3_tools@1"
        },
        {
          "command": "mcpy.developmentEnvironment",
          "group": "3_tools@0"
        }
      ]
    },
    "submenus": [
      {
        "id": "mcpy.projectActions",
        "label": "游戏测试",
        "icon": "$(beaker)"
      }
    ],
    "keybindings": [
      {
        "command": "mcpy.runSnippet",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && mcpy.snippetActive"
      }
    ],
    "languages": [
      {
        "id": "mcpy-log",
        "aliases": [
          "mcpy log"
        ]
      },
      {
        "id": "mcpy-runtime-python",
        "aliases": [
          "游戏内 Python (mcpy)"
        ],
        "extensions": [
          ".mcpy.py"
        ],
        "configuration": "./syntaxes/mcpy-runtime-python.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mcpy-log",
        "scopeName": "text.mcpy-log",
        "path": "./syntaxes/mcpy-log.tmLanguage.json"
      },
      {
        "language": "mcpy-runtime-python",
        "scopeName": "source.mcpy-runtime-python",
        "path": "./syntaxes/mcpy-runtime-python.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.mcpy.timestamp",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "comment.mcpy.member",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "comment.mcpy.debug",
            "settings": {
              "foreground": "#808080"
            }
          },
          {
            "scope": "invalid.mcpy.error",
            "settings": {
              "foreground": "#E5484D"
            }
          },
          {
            "scope": "markup.deleted.mcpy.warning",
            "settings": {
              "foreground": "#C69320"
            }
          },
          {
            "scope": "markup.deleted.mcpy.event",
            "settings": {
              "foreground": "#C69320"
            }
          },
          {
            "scope": "markup.inserted.mcpy.success",
            "settings": {
              "foreground": "#4EA52E"
            }
          },
          {
            "scope": "entity.name.tag.mcpy.engine",
            "settings": {
              "foreground": "#3794FF"
            }
          },
          {
            "scope": "entity.name.tag.mcpy.load",
            "settings": {
              "foreground": "#3794FF"
            }
          },
          {
            "scope": "keyword.control.mcpy.tag",
            "settings": {
              "foreground": "#C586C0"
            }
          },
          {
            "scope": "constant.language.mcpy.response",
            "settings": {
              "foreground": "#2AA198"
            }
          },
          {
            "scope": "constant.language.mcpy.closed",
            "settings": {
              "foreground": "#2AA198"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js test/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run build",
    "vscode:prepublish": "npm run check",
    "package": "vsce package",
    "test:extension": "node scripts/test-extension.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "4.0.1-4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "extensionPack": [
    "ms-python.python",
    "ms-python.vscode-pylance"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "mcpywrap",
    "minecraft",
    "netease",
    "modsdk",
    "python",
    "hot reload"
  ],
  "galleryBanner": {
    "color": "#17343c",
    "theme": "dark"
  }
}
